# Currently just checks for the presence of clang on the system, used to simplify zopen build 
# In the future, this will be used to build clang from source

export ZOPEN_TYPE="BARE"
export ZOPEN_CATEGORIES="development"
export ZOPEN_RUNTIME_DEPS="which"

export ZOPEN_NAME="check_clang"
export ZOPEN_CONFIGURE=skip
export ZOPEN_CHECK=zopen_check
export ZOPEN_MAKE=skip
export ZOPEN_INSTALL=zopen_install
DEFAULT_OS_VER="zosv2r5"
DEFAULT_ARCH="z13"
BASE_COMMON_FLAGS="-fzos-le-char-mode=ascii -mnocsect -fno-short-enums -m64 -mzos-target=${DEFAULT_OS_VER} -march=${DEFAULT_ARCH}"
BASE_C_FLAGS="-std=gnu11"
BASE_CXX_FLAGS=""

zopen_check()
{
  # Nothing to check at this time
}

zopen_check_results()
{
  # Nothing to check here, assume everything passed
  echo "actualFailures:0"
  echo "totalTests:1"
  echo "expectedFailures:1"
  echo "expectedTotalTests:1"
}

zopen_append_to_env()
{
cat <<zz
  # Only execute during zopen build
  if [ -z "\$ZOPEN_IN_ZOPEN_BUILD" ]; then
    return 0
  fi

  # Constants
  CLANG_DOWNLOAD_URL="https://epwt-www.mybluemix.net/software/support/trial/cst/programwebsite.wss?siteId=1803"
  MIN_COMPILER_VER=50000000  # OEL 2.0.0

  # ============================================================================
  # Detect clang compiler
  # ============================================================================
  # Prefer OEL clang over ibm-clang64 (unless ZOPEN_COMP is set to openxl)
  CLANG_PATH=""
  CLANG_WRAPPER_PATH=""
  CLANG_BIN=""

  if [ "\${ZOPEN_COMP}" != "openxl" ]; then
    # Use which -a to find all clang instances. We need to identify:
    # 1. The real z/OS clang compiler (validates with --version)
    # 2. Any wrapper (sage/ccache) that appeared before it in PATH
    for _candidate in \$(PATH="\$ZOPEN_OLD_PATH" which -a clang 2>/dev/null); do
      # Check if this is a symlink to a known wrapper (sage, ccache, etc.)
      _is_wrapper=false
      if [ -L "\$_candidate" ]; then
        _link_target=\$(ls -l "\$_candidate" 2>/dev/null | awk -F' -> ' '{print \$2}')
        case "\$_link_target" in
          *sage*|*ccache*|*distcc*|*sccache*)
            _is_wrapper=true
            ;;
        esac
      fi

      if [ "\$_is_wrapper" = "true" ]; then
        # Remember the first wrapper we find
        if [ -z "\$CLANG_WRAPPER_PATH" ]; then
          CLANG_WRAPPER_PATH="\$_candidate"
        fi
        continue
      fi

      # Verify it's a real z/OS clang by checking --version output
      if "\$_candidate" --version 2>&1 | grep -q "s390x\\?-ibm-zos"; then
        CLANG_PATH="\$_candidate"
        CLANG_BIN="clang"
        break
      fi
      # Also try with STEPLIB in case it needs it
      if STEPLIB="\$ZOPEN_OLD_STEPLIB" "\$_candidate" --version 2>&1 | grep -q "s390x\\?-ibm-zos"; then
        CLANG_PATH="\$_candidate"
        CLANG_BIN="clang"
        export STEPLIB="\$ZOPEN_OLD_STEPLIB"
        break
      fi
    done
    unset _candidate _link_target _is_wrapper
  fi

  # Fallback to ibm-clang64 if OEL clang not found
  if [ -z "\${CLANG_BIN}" ]; then
    CLANG_PATH=\$(PATH="\$ZOPEN_OLD_PATH" which ibm-clang64 2>/dev/null)
    if [ -n "\${CLANG_PATH}" ]; then
      CLANG_BIN="ibm-clang64"
    fi
  fi

  # Exit if no clang compiler found
  if [ -z "\${CLANG_PATH}" ]; then
    echo "Error: clang not found. Please download and install from \${CLANG_DOWNLOAD_URL}" >&2
    return 1
  fi

  # ============================================================================
  # Validate clang functionality
  # ============================================================================
  # Test if clang executable runs (for ibm-clang64 fallback path which
  # didn't go through the which -a validation above)
  if [ "\${CLANG_BIN}" = "ibm-clang64" ]; then
    if ! "\${CLANG_PATH}" --version >/dev/null 2>&1; then
      if STEPLIB="\$ZOPEN_OLD_STEPLIB" "\${CLANG_PATH}" --version >/dev/null 2>&1; then
        export STEPLIB="\$ZOPEN_OLD_STEPLIB"
      else
        echo "Error: clang executable is not functional. Please download and install from \${CLANG_DOWNLOAD_URL}" >&2
        return 1
      fi
    fi

    # Verify it's a z/OS clang compiler
    if ! "\${CLANG_PATH}" --version 2>&1 | grep -q "s390x\\?-ibm-zos"; then
      echo "Error: clang executable is not a z/OS compiler. Please download and install from \${CLANG_DOWNLOAD_URL}" >&2
      return 1
    fi
  fi

  # ============================================================================
  # Setup compiler environment
  # ============================================================================
  # Add the real clang directory first, then the wrapper (if any) in front
  # so the wrapper intercepts calls but can still find the real compiler
  export PATH="\$(dirname "\${CLANG_PATH}"):\${PATH}"
  if [ -n "\${CLANG_WRAPPER_PATH}" ]; then
    export PATH="\$(dirname "\${CLANG_WRAPPER_PATH}"):\${PATH}"
  fi

  # Configure compiler based on detected type
  if [ "\${CLANG_BIN}" = "ibm-clang64" ]; then
    export CC="ibm-clang64"
    export CXX="ibm-clang++64"
    export ZOPEN_COMP="OPENXL"
    EXTRA_CFLAGS=""
    EXTRA_CXXFLAGS=""
  else
    export CC="clang"
    export CXX="clang++"
    export ZOPEN_COMP="CLANG"
    EXTRA_CFLAGS="-fno-builtin-malloc -fno-builtin-calloc -fno-builtin-realloc"
    EXTRA_CXXFLAGS="-fno-builtin-malloc -fno-builtin-calloc -fno-builtin-realloc"
  fi

  # Setup compiler flags
  export ZOPEN_CFLAGS="${BASE_C_FLAGS} ${BASE_COMMON_FLAGS} \${EXTRA_CFLAGS}"
  export ZOPEN_CXXFLAGS="${BASE_CXX_FLAGS} ${BASE_COMMON_FLAGS} \${EXTRA_CXXFLAGS}"
  export ZOPEN_CPPFLAGS="-fzos-le-char-mode=ascii -m64 -mzos-target=${DEFAULT_OS_VER} -march=${DEFAULT_ARCH} -DNSIG=42 -D_XOPEN_SOURCE=600 -D_ALL_SOURCE -D_OPEN_SYS_FILE_EXT=1 -D_AE_BIMODAL=1 -D_ENHANCED_ASCII_EXT=0xFFFFFFFF"
  export ZOPEN_LDFLAGS="-Wl,-bcompress=yes -m64"

  # Adjust optimization flags for release mode
  if \$buildInReleaseMode; then
    ZOPEN_CFLAGS="\${ZOPEN_CFLAGS} -O3"
    ZOPEN_CXXFLAGS="\${ZOPEN_CXXFLAGS} -O3"
  else
    ZOPEN_LDFLAGS=""
  fi

  # ============================================================================
  # Validate compiler versions
  # ============================================================================
  # Check C compiler version
  cc_ver=\$(\${CC} -E -dM - </dev/null 2>/dev/null | grep '__COMPILER_VER__' | awk '{print substr(\$3,3)}')
  if [ -z "\${cc_ver}" ]; then
    echo "Warning: C compiler is not an IBM C/C++ for Open Enterprise Languages on z/OS compiler" >&2
  elif [ "\${cc_ver}" -lt "\${MIN_COMPILER_VER}" ]; then
    echo "Warning: C compiler must be at least IBM C for Open Enterprise Languages on z/OS 2.0.0" >&2
  fi

  # Check C++ compiler version
  cxx_ver=\$(\${CXX} -x c++ -E -dM - </dev/null 2>/dev/null | grep '__COMPILER_VER__' | awk '{print substr(\$3,3)}')
  if [ -z "\${cxx_ver}" ]; then
    echo "Warning: C++ compiler is not an IBM C/C++ for Open Enterprise Languages on z/OS compiler" >&2
  elif [ "\${cxx_ver}" -lt "\${MIN_COMPILER_VER}" ]; then
    echo "Warning: C++ compiler must be at least IBM C for Open Enterprise Languages on z/OS 2.0.0" >&2
  fi

zz
}

zopen_install() {
  mkdir -p $ZOPEN_INSTALL_DIR/bin
  cp -r $ZOPEN_ROOT/bin/* $ZOPEN_INSTALL_DIR/bin
}

zopen_get_version()
{
  PATH=$ZOPEN_OLD_PATH clang --version | head -1 | awk '{print $12; }'
}
